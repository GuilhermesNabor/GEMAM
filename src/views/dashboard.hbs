<div id="dashboard-layout"> 
    <header class="dashboard-header">
        <h1>Sistema de Gerenciamento GEMAM</h1>
        <nav>
            <a href="/logout" id="logout-btn"><i class="fas fa-sign-out-alt"></i> Sair</a>
        </nav>
    </header>

    <main class="container">

        <div id="standard-home-section" class="dashboard-card hidden">
            <h2><i class="fas fa-user-tag"></i> Área da Equipe</h2>
            <p>Bem-vindo, <strong>{{user.name}}</strong>.</p>
            <p>Você está vinculado à empresa. Em breve você poderá lançar coletas aqui.</p>
            
            <div style="margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 5px;">
                <h4>Status da Conta</h4>
                <ul style="list-style: none; padding: 0;">
                    <li><i class="fas fa-check-circle" style="color:green"></i> Usuário Ativo</li>
                    <li><i class="fas fa-building"></i> Empresa Vinculada</li>
                </ul>
            </div>
        </div>
        
        <div class="dashboard-card" id="admin-actions-card" style="display: none;"> <h2>Ações Rápidas</h2>
            <a href="/destination/register" class="ghost-button" style="background: #3498db; padding: 15px; border-radius: 5px; text-decoration: none; display: inline-block; color: white;">
                <i class="fas fa-truck"></i> Cadastrar Empresa de Destino
            </a>
            <a href="/crre/register" class="ghost-button" style="background: #8e44ad; padding: 15px; border-radius: 5px; text-decoration: none; display: inline-block; color: white; margin-left: 10px;">
                <i class="fas fa-file-contract"></i> Emitir CRRE
            </a>
        </div>

        <div id="admin-dest-list-section" class="dashboard-card hidden">
            <h2><i class="fas fa-list"></i> Meus Destinos Cadastrados</h2>
            <ul id="my-dest-list" class="status-list">
                <li>Carregando...</li>
            </ul>
        </div>

        <div id="register-standard-section" class="dashboard-card hidden">
            <h2><i class="fas fa-user-plus"></i> Cadastrar Novo Usuário (Equipe)</h2>
            <form id="register-standard-form">
                <div class="form-group">
                    <label for="standard_name"><i class="fas fa-user icon-prefix"></i> Nome do Contato:</label>
                    <input type="text" id="standard_name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="standard_phone"><i class="fas fa-phone icon-prefix"></i> Telefone:</label>
                    <input type="tel" id="standard_phone" name="phone" placeholder="(XX) XXXXX-XXXX" required>
                </div>
                <div class="form-group">
                    <label for="standard_email"><i class="fas fa-envelope icon-prefix"></i> E-mail:</label>
                    <input type="email" id="standard_email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="standard_password"><i class="fas fa-lock icon-prefix"></i> Senha:</label>
                    <input type="password" id="standard_password" name="password" required>
                </div>
                <button type="submit">Cadastrar Usuário</button>
            </form>
        </div>

        <div id="team-list-section" class="dashboard-card hidden">
            <h2><i class="fas fa-users"></i> Minha Equipe</h2>
            <ul id="team-list" class="status-list">
                <li>Carregando...</li>
            </ul>
        </div>

        <div id="admin-logs-section" class="dashboard-card hidden">
            <h2><i class="fas fa-clipboard-list"></i> Registro de Atividades da Equipe</h2>
            <ul id="admin-logs-list" class="logs-list" style="list-style: none; padding: 0;">
                <li>Carregando...</li>
            </ul>
        </div>


        <div id="aps-admin-section" class="dashboard-card hidden">
            <h2><i class="fas fa-user-clock"></i> Solicitações de Cadastro (Admins)</h2>
            <p>Gerencie as solicitações de cadastro de novas empresas.</p>
            <ul id="pending-admins-list">
                <li>Carregando...</li>
            </ul>
        </div>

        <div id="aps-active-admins-section" class="dashboard-card hidden">
            <h2><i class="fas fa-user-shield"></i> Gerenciar Empresas Ativas</h2>
            <p class="warning-text" style="color: #e74c3c; font-size: 0.9rem; margin-bottom: 10px;">
                <i class="fas fa-exclamation-triangle"></i> Atenção: Deletar um Admin removerá todos os usuários vinculados.
            </p>
            <ul id="active-admins-list" class="status-list">
                <li>Carregando...</li>
            </ul>
        </div>

        <div id="aps-dest-section" class="dashboard-card hidden">
            <h2><i class="fas fa-building"></i> Aprovação de Empresas de Destino</h2>
            <ul id="pending-dest-list">
                <li>Carregando...</li>
            </ul>

            <hr style="margin: 25px 0; border-top: 1px solid #eee;">
            
            <h3><i class="fas fa-history"></i> Histórico de Processamento</h3>
            <ul id="history-dest-list" class="status-list">
                <li>Carregando...</li>
            </ul>
        </div>

        <div id="aps-logs-section" class="dashboard-card hidden">
            <h2><i class="fas fa-globe"></i> Registro Global de Atividades</h2>
            <ul id="aps-logs-list" class="logs-list" style="list-style: none; padding: 0;">
                <li>Carregando...</li>
            </ul>
        </div>
        
        <div id="message-area-dashboard" class="message-area"></div>
    </main>
</div>

<script>
    const userRole = '{{user.role}}';
</script>
<script src="/js/dashboard-main.js?v=15"></script>